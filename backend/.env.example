# 서버 포트
PORT=4000

# ---- AI / OCR 연동 설정 ----
# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료로 발급 가능)
# 값을 비워두면 AI 기능은 자동으로 비활성화되고, 사용자가 직접 입력하는 방식으로만 동작합니다.
GEMINI_API_KEY=

# 이미지 배경 제거에 사용할 provider: gemini | noop
# GEMINI_API_KEY가 설정되어 있으면 자동으로 gemini, 없으면 noop으로 동작합니다.
AI_IMAGE_PROVIDER=

# OCR/정보 추출에 사용할 provider: gemini | noop
AI_OCR_PROVIDER=
