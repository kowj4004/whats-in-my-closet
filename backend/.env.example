# 서버 포트
PORT=4000

# ---- AI / OCR 연동 설정 ----
# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료로 발급 가능)
# 값을 비워두면 로컬 OCR이 정보를 못 찾았을 때의 보조 수단으로도 쓰이지 않습니다(선택 사항).
GEMINI_API_KEY=

# 이미지 배경 제거에 사용할 provider: local | gemini | noop
# 기본값은 local — 과금/할당량 없는 오픈소스 모델을 이 서버에서 직접 돌립니다.
AI_IMAGE_PROVIDER=local

# OCR/정보 추출에 사용할 provider: local | gemini | noop
# 기본값은 local(Tesseract+정규식). 가격/사이즈를 못 찾으면 GEMINI_API_KEY가 있을 때만 보조로 시도합니다.
AI_OCR_PROVIDER=local
