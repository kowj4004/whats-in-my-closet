# 서버 포트
PORT=4000

# ---- 데이터베이스(Supabase Postgres) ----
# 비워두면 backend/data/*.json 파일을 그대로 사용합니다(로컬 개발 기본값).
# Supabase 프로젝트의 직접 연결 호스트(db.*.supabase.co)는 IPv6 전용이라 접속이 안 될 수 있습니다 —
# Project Settings > Database > Connection string에서 Session/Transaction Pooler 문자열을 쓰세요.
DATABASE_URL=

# ---- 파일 저장소(Supabase Storage) ----
# 셋 다 비워두면 backend/uploads/ 로컬 디스크를 그대로 사용합니다(로컬 개발 기본값).
# 배포 환경(Render 등)처럼 디스크가 매번 초기화되는 곳에서는 반드시 채워야 사진이 유지됩니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=closet-images

# ---- AI / OCR 연동 설정 ----
# Gemini API 키 (https://aistudio.google.com/apikey 에서 무료로 발급 가능)
# 값을 비워두면 로컬 OCR이 정보를 못 찾았을 때의 보조 수단으로도 쓰이지 않습니다(선택 사항).
GEMINI_API_KEY=

# 이미지 배경 제거에 사용할 provider: local | gemini | noop
# 기본값은 local — 과금/할당량 없는 오픈소스 모델을 이 서버에서 직접 돌립니다.
AI_IMAGE_PROVIDER=local

# OCR/정보 추출에 사용할 provider: local | gemini | noop
# 기본값은 local(Tesseract+정규식). 가격/사이즈를 못 찾으면 GEMINI_API_KEY가 있을 때만 보조로 시도합니다.
AI_OCR_PROVIDER=local
